{
  "schemaVersion": 1,
  "id": "jcraftotp",
  "version": "${version}",
  "name": "JCraft Over The Top",
  "description": "Another JCraft Addon, but made by a JCraft dev",
  "authors": [
    "Ayutac"
  ],
  "contact": {
    "homepage": "https://discord.abos.studio",
    "sources": "https://github.com/Ayutac/jcraft_otp"
  },
  "license": "All Rights Reserved",
  "icon": "assets/jcraftotp/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "studio.abos.mc.jcraftotp.fabric.JCraftOtpFabric"
    ],
    "client": [
      "studio.abos.mc.jcraftotp.client.JCraftOtpFabricClient"
    ],
    "cardinal-components": [
      "studio.abos.mc.jcraftotp.fabric.common.component.Components"
    ],
    "fabric-datagen": [
      "studio.abos.mc.jcraftotp.fabric.datagen.JCraftOtpDataGen"
    ]
  },
  "mixins": [
    "jcraftotp.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "architectury": ">=9.2.14",
    "jcraft": ">=0.18.2"
  },
  "custom": {
    "cardinal-components": [
      "jcraftotp:civil_war"
    ]
  }
}
